#!/usr/bin/env bash
#MISE description="Bump the version from conventional commits, tag and push (CI only)"
set -euo pipefail

git config user.name  "github-actions[bot]"
git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

# cog owns the conventional-commit rules. --dry-run prints the next tag on its last line, and
# exits 0 even when nothing warrants a release — so the tag string, not the exit code, is the
# signal. Deciding here keeps the no-release case (roughly two pushes in five) free of a bump.
tag="$(cog bump --auto --dry-run 2>/dev/null | tail -1)"
out="${GITHUB_OUTPUT:-/dev/stdout}"
if [[ ! "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+ ]]; then
  echo "released=false" >>"$out"
  echo "::notice title=No release::No commit since the last tag implies a version bump."
  exit 0
fi

# cog writes CHANGELOG.md, runs the pre_bump_hook (`uv version`) and cuts the tag; squash-only
# merges make each commit subject the PR title pr-title.yml verified.
cog bump --auto --skip-ci
# By name, because cog's tags are lightweight and `--follow-tags` pushes annotated ones only.
git push origin HEAD:main "$tag"
{ echo "released=true"; echo "version=$tag"; } >>"$out"
