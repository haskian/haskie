#!/usr/bin/env bash
#MISE description="Lint, format and type-check Python (ruff, ty) and web (oxlint, tsc). Pass --fix to apply fixes; CI runs it read-only."
set -euo pipefail
if [ "${1:-}" = "--fix" ]; then
  uv run ruff check --fix src tests
  uv run ruff format src tests
else
  uv run ruff check src tests
  uv run ruff format --check src tests
fi
uv run ty check
(cd web && bun run lint && bunx tsc -b)
