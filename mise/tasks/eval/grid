#!/usr/bin/env bash
#MISE description="Run every arm on every task. Args: [runs-dir] [repeats] [model]. Resumable."
set -euo pipefail
# A comment pasted in with the command becomes an argument: zsh only strips `#` interactively
# when interactive_comments is set, and a run directory named `#` is not a helpful error.
args=()
for a in "$@"; do case "$a" in \#*) break ;; *) args+=("$a") ;; esac; done
set -- "${args[@]+"${args[@]}"}"
uv run haskie ensure --url http://127.0.0.1:8000/mcp
uv run python -m evals.grid "${1:-evals/runs}" "${2:-5}" "${3:-sonnet}"
