#!/usr/bin/env bash
#MISE description="Check every eval task separates a no-library run from a haskie run; non-zero if one does not"
set -euo pipefail
# A comment pasted in with the command becomes an argument: zsh only strips `#` interactively
# when interactive_comments is set, and a run directory named `#` is not a helpful error.
args=()
for a in "$@"; do case "$a" in \#*) break ;; *) args+=("$a") ;; esac; done
set -- "${args[@]+"${args[@]}"}"
# A task both arms pass measures the model's memory, and one neither passes measures the
# assertion. Either way it says nothing about haskie, so this gate runs before any grid.
uv run haskie ensure --url http://127.0.0.1:8000/mcp
uv run python -m evals.calibrate "${1:-evals/calibration}"
