#!/usr/bin/env bash
#MISE description="Does Claude reach for haskie when a prompt never mentions it? Activation only, a few turns per run, per setup (none, rule, hook, rule+hook). Starts the full-text eval instance. Args: [--setups ...] [--samples N] [--model M] [--only ID...]"
set -euo pipefail
home="${HASKIE_EVAL_HOME:-$PWD/evals/.haskie-eval}"
api="${HASKIE_EVAL_URL:-http://127.0.0.1:8123}"
uv run haskie run --home "$home" --port "${api##*:}" --no-browser
uv run python -m evals.activation.run --api "$api" "$@"
