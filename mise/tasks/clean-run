#!/usr/bin/env bash
#MISE description="Destroy ~/haskie-dev, reinstall the freshly built package and run it on a clean home"
#MISE depends=["build"]
set -euo pipefail
# HASKIE_HOME comes from mise.toml, so every command below works on ~/haskie-dev.
# a server still running would keep writing into the files destroy deletes
uv run haskie stop
uv run haskie destroy
# every extra, as the install guides do: each one's marker makes it a no-op where it cannot run
uv sync --all-extras --reinstall-package haskie
# in the background, as a user starts it: a clean home opens the first-run page
uv run haskie run
